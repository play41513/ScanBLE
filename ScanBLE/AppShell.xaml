<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="ScanBLE.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:ScanBLE"
    Shell.FlyoutBehavior="Disabled">

    <!-- 底部 Tab 區域 -->
    <TabBar>
        <Tab Title="Scanner" Icon="bluetooth_searching.png">
            <ShellContent ContentTemplate="{DataTemplate local:MainPage}" />
        </Tab>
        <Tab Title="History" Icon="history.png">
            <ShellContent ContentTemplate="{DataTemplate local:HistoryPage}" />
        </Tab>
        <Tab Title="Setting" Icon="settings.png">
            <ShellContent ContentTemplate="{DataTemplate local:SettingsPage}" />
        </Tab>
    </TabBar>

</Shell>